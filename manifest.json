{
  "manifest_version": 3,
  "name": "AudioLab",
  "version": "0.1.0",
  "description": "Real-Time Web Audio Inspector + Loudness Normalizer",
  "permissions": ["scripting", "activeTab", "tabs", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AudioLab",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js", "overlay/overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["page/page-script.js", "overlay/overlay.css", "worklet/analyzer-processor.js", "fonts/DMSans-latin.woff2", "fonts/DMSans-latin-ext.woff2"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-playback": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Play/pause the current audio"
    },
    "jump-to-playing": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Jump to the tab that is currently playing"
    }
  }
}
